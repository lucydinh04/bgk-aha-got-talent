# ═══════════════════════════════════════════════════════════════════════════
# AHA GOT TALENT 2026 — biến môi trường
#
# Copy sang .env.local cho máy local, hoặc dán vào phần Variables của Railway /
# Render cho production. KHÔNG commit file .env.local.
#
# Chỉ liệt kê biến CODE THẬT SỰ ĐANG ĐỌC. Không có biến trang trí.
# ═══════════════════════════════════════════════════════════════════════════

# ── BẮT BUỘC Ở PRODUCTION ──────────────────────────────────────────────────

# Địa chỉ công khai của app. Dùng để in QR bình chọn lên màn LED và dựng link.
# Thiếu biến này ở production, app CỐ Ý crash lúc khởi động thay vì in ra một
# QR trỏ về localhost giữa hội trường.
# Railway/Render tự đặt RAILWAY_PUBLIC_DOMAIN / RENDER_EXTERNAL_URL — nếu có
# sẵn thì biến này không bắt buộc, nhưng đặt tường minh vẫn tốt hơn.
NEXT_PUBLIC_APP_URL=https://talent.example.com

# Khoá ký cookie phiên đăng nhập.
# Không đặt thì app tự sinh và lưu trong bảng `settings` của DB — chạy được,
# nhưng đặt tường minh sẽ tiện hơn: đổi giá trị này là đá toàn bộ phiên ra.
# Sinh khoá:  openssl rand -hex 32
SESSION_SECRET=

# ── TUỲ CHỌN ───────────────────────────────────────────────────────────────

# Nơi đặt file SQLite. Trên Railway/Render phải trỏ vào VOLUME đã mount,
# nếu không dữ liệu mất sau mỗi lần deploy.
# Mặc định: <thư mục app>/.data/aha.db
AHA_DB_PATH=/data/aha.db

# Google Sheet nguồn đăng ký. Mặc định đã là sheet Aha Talent 2026.
# Sheet đang share "anyone with the link" nên KHÔNG cần service account.
GOOGLE_SHEET_ID=1D-kqGPIj6N2_xv0b0PxmYU8dOe2P8wGull7dBZX3yX4

# Bảo vệ /api/health. Để trống thì endpoint công khai (chỉ trả trạng thái,
# không trả secret). Đặt giá trị thì phải gọi kèm ?token=... hoặc header
# x-health-token.
HEALTH_CHECK_TOKEN=

# Cổng. Railway/Render tự đặt; chỉ chỉnh khi chạy local nhiều instance.
# PORT=3000
